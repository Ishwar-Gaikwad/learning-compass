# Server Environment Setup
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learning_compass?retryWrites=true&w=majority


JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Frontend Origin URL
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173


STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=learning-compass-materials

# Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.pptx,.jpg,.jpeg,.png,.webp,.gif

# AI Provider Configuration (local | openai)
LLM_PROVIDER=local
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gpt-4o-mini

# Embedding Provider Configuration (local | openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# OCR Provider Configuration (local | openai)
OCR_PROVIDER=local
OCR_MODEL=gpt-4o-mini

# MongoDB Atlas Vector Search Configuration
VECTOR_INDEX_NAME=document_chunks_vector_index
VECTOR_SEARCH_PATH=embedding
VECTOR_SEARCH_NUM_CANDIDATES=50
VECTOR_SEARCH_LIMIT=5
